FROM python:3.12-slim

# Set the working directory in the container
WORKDIR /app

# Runtime dependency for xgboost/shap native extensions on slim images
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for dependency management/execution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install dependencies first for better Docker layer caching
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy backend code and model artifacts
COPY scripts/ scripts/
COPY api/ api/
COPY artifacts/ artifacts/

# Expose the port the API will run on
EXPOSE 8000

# Run the API using uvicorn, allowing the port to be set via environment variable
CMD ["sh", "-c", "uv run uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
